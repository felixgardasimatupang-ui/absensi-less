# ===================================================================
# Absensi Les — Backend Environment Variables
# Salin file ini menjadi .env dan isi nilai yang sesuai
# JANGAN commit file .env ke repository!
# ===================================================================

# Server
PORT=3000
NODE_ENV=development

# ===================================================================
# JWT Configuration
# JWT_SECRET: Gunakan string acak minimal 64 karakter untuk production
# Buat dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_EXPIRY: 1h (development) | 15m (production — gunakan refresh token)
# ===================================================================
JWT_SECRET=replace-with-a-strong-random-secret-min-64-chars
JWT_EXPIRY=1h

# ===================================================================
# Database
# Development:  file:./prisma/dev.db  (SQLite — tidak perlu setup)
# Production:   postgresql://USER:PASS@HOST:5432/DB_NAME
#               (Railway: gunakan DATABASE_URL dari dashboard Railway)
# ===================================================================
DATABASE_URL="file:./prisma/dev.db"

# ===================================================================
# CORS — domain frontend yang diizinkan (pisahkan dengan koma)
# Development: http://localhost:5173
# Production:  https://your-frontend-domain.vercel.app
# ===================================================================
CORS_ORIGINS=http://localhost:5173

# ===================================================================
# PostgreSQL (untuk docker-compose --profile production)
# Isi variabel ini jika menggunakan Docker PostgreSQL
# ===================================================================
# POSTGRES_USER=absensiles_user
# POSTGRES_PASSWORD=absensiles_secure_password_change_me
# POSTGRES_DB=absensiles_db

# ===================================================================
# Demo seed users — dibuat oleh `npm run seed`
# admin@absensiles.local    / Admin1234!
# tutor@absensiles.local    / Tutor1234!
# student@absensiles.local  / Student1234!
# ===================================================================
